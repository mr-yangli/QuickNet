<Solution>
  <Folder Name="/src/">
    <Project Path="excel/src/QuickExcel/QuickExcel.csproj" />
    <Project Path="word/src/QuickWord/QuickWord.csproj" />
    <Project Path="pdf/src/QuickPdf/QuickPdf.csproj" />
    <Project Path="sql/src/QuickSql.Abstractions/QuickSql.Abstractions.csproj" />
    <Project Path="sql/src/QuickSql.Core/QuickSql.Core.csproj" />
    <Project Path="sql/src/QuickSql.Generators/QuickSql.Generators.csproj" />
    <!-- 方言族：SqlServer（单层） -->
    <Project Path="sql/src/QuickSql.Providers.SqlServer/QuickSql.Providers.SqlServer.csproj" />
    <!-- 方言族：PostgreSQL（血统 + 五叶 + 本尊） -->
    <Project Path="sql/src/QuickSql.Providers.PostgreSqlBase/QuickSql.Providers.PostgreSqlBase.csproj" />
    <Project Path="sql/src/QuickSql.Providers.Kingbase/QuickSql.Providers.Kingbase.csproj" />
    <Project Path="sql/src/QuickSql.Providers.OpenGauss/QuickSql.Providers.OpenGauss.csproj" />
    <Project Path="sql/src/QuickSql.Providers.GaussDb/QuickSql.Providers.GaussDb.csproj" />
    <Project Path="sql/src/QuickSql.Providers.Highgo/QuickSql.Providers.Highgo.csproj" />
    <Project Path="sql/src/QuickSql.Providers.Gbase8c/QuickSql.Providers.Gbase8c.csproj" />
    <!-- PG 血统的正典叶（v0.37 第二笔）：这一族第一颗"本尊"，而 §9.1 那张表里 PG 与 MySQL 两个本尊都没有行。 -->
    <Project Path="sql/src/QuickSql.Providers.PostgreSql/QuickSql.Providers.PostgreSql.csproj" />
    <!-- PG 血统的第七颗叶子（DuckDB 落笔）：前六颗叶子在文本层全部零覆写、产出逐字同形，本家是这一族
         第一颗真的改了血统产出的叶子（类型表四格换名、身份列换句外 CREATE SEQUENCE + nextval 形态、
         "建库"整格不存在）。它同时开了血统基类的两道缝（CreateCodeFirst/CreateDialect）—— 与 Oracle
         那一族同一条先例。 -->
    <Project Path="sql/src/QuickSql.Providers.DuckDb/QuickSql.Providers.DuckDb.csproj" />
    <!-- 方言族：Oracle（血统 + 两叶 + 本尊） -->
    <Project Path="sql/src/QuickSql.Providers.OracleBase/QuickSql.Providers.OracleBase.csproj" />
    <Project Path="sql/src/QuickSql.Providers.Dameng/QuickSql.Providers.Dameng.csproj" />
    <Project Path="sql/src/QuickSql.Providers.ShenTong/QuickSql.Providers.ShenTong.csproj" />
    <!-- Oracle 血统的正典叶（v0.37 第三笔）：这一族第二颗"本尊"，而它到场兑现的是自家基类注释里挂了四版的那颗住户。 -->
    <Project Path="sql/src/QuickSql.Providers.Oracle/QuickSql.Providers.Oracle.csproj" />
    <!-- 方言族：MySQL（血统 + 三叶 + 本尊） -->
    <Project Path="sql/src/QuickSql.Providers.MySqlBase/QuickSql.Providers.MySqlBase.csproj" />
    <Project Path="sql/src/QuickSql.Providers.MySql/QuickSql.Providers.MySql.csproj" />
    <Project Path="sql/src/QuickSql.Providers.TiDb/QuickSql.Providers.TiDb.csproj" />
    <Project Path="sql/src/QuickSql.Providers.OceanBase/QuickSql.Providers.OceanBase.csproj" />
    <!-- 方言族：单层（虚谷 / GBase 8s / SQLite） -->
    <Project Path="sql/src/QuickSql.Providers.Xugu/QuickSql.Providers.Xugu.csproj" />
    <Project Path="sql/src/QuickSql.Providers.Gbase8s/QuickSql.Providers.Gbase8s.csproj" />
    <!-- 第七家（本笔）：第四颗单层整层，而它是这一串里第一颗断言逐格向活库问过的——本机一个文件就是一座库。 -->
    <Project Path="sql/src/QuickSql.Providers.Sqlite/QuickSql.Providers.Sqlite.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="excel/tests/QuickExcel.Tests/QuickExcel.Tests.csproj" />
    <Project Path="word/tests/QuickWord.Tests/QuickWord.Tests.csproj" />
    <Project Path="pdf/tests/QuickPdf.Tests/QuickPdf.Tests.csproj" />
    <Project Path="sql/tests/QuickSql.Tests.Dialects/QuickSql.Tests.Dialects.csproj" />
    <Project Path="sql/tests/QuickSql.Tests.Integration/QuickSql.Tests.Integration.csproj" />
  </Folder>
  <Folder Name="/samples/">
    <Project Path="sql/samples/QuickSql.Sample/QuickSql.Sample.csproj" />
    <Project Path="excel/samples/QuickExcel.Sample/QuickExcel.Sample.csproj" />
    <Project Path="word/samples/QuickWord.Sample/QuickWord.Sample.csproj" />
    <Project Path="pdf/samples/QuickPdf.Sample/QuickPdf.Sample.csproj" />
  </Folder>
  <Folder Name="/benchmarks/">
    <Project Path="excel/benchmarks/QuickExcel.Benchmarks/QuickExcel.Benchmarks.csproj" />
    <Project Path="sql/benchmarks/QuickSql.Benchmarks/QuickSql.Benchmarks.csproj" />
  </Folder>
</Solution>
