<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FastSql.Tests.Dialects</RootNamespace>
    <Description>方言黄金样本：不连库，比对 AST→文本的产出（§13.1）。用「一调就抛」的桩工厂，所以任何一次驱动调用都是设计约束被破坏的信号。</Description>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSql.Tests.Common\FastSql.Tests.Common.csproj" />
  </ItemGroup>

  <!-- 编译期负样本的断言口（§14）：这里把生成器当**普通程序集**引用，而不是像 FastSql.Tests.Common
       那样挂成 Analyzer。本类的做法是自己在内存里造一份 CSharpCompilation、用 CSharpGeneratorDriver
       显式跑一遍 EntityContractGenerator，好把诊断逐条钉住——按 Analyzer 挂法只能在本项目自己编译时
       跑一次，诊断混进构建输出，测试拿不到「同一段源码在/不在生成器下各是什么结论」。
       反过来讲：本项目的实体样例仍然没挂生成器，所以负样本能写在这里而不会把构建弄红。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <ProjectReference Include="..\..\src\FastSql.Generators\FastSql.Generators.csproj" />
  </ItemGroup>

</Project>
