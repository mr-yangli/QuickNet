<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FastSql.Providers.Dameng</RootNamespace>
    <Description>FastSql ORM 的达梦 provider：Oracle 血统上的一层薄壳（§9.1）。今天它只覆写一处 —— 自增列的写法（<c>IDENTITY(1,1)</c> 而不是 <c>GENERATED BY DEFAULT AS IDENTITY</c>），因为那一格的形状与 SQL Server 同形而与其血统基类不同形。分页、引号、类型映射、守卫全部继承基类，而它们<em>没有</em>在一台活库上跑过（§13.5 台账里这一家整行是「未实测」）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastSql.Providers.OracleBase\FastSql.Providers.OracleBase.csproj" />
  </ItemGroup>

</Project>
