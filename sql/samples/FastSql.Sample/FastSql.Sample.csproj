<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FastSql.Sample</RootNamespace>
    <Description>FastSql ORM 示例：DI 注册、建库、同步表、增删改查、主从明细增删改查。</Description>
    <!-- 示例项目不需要 AOT/trimming 安全；Set<T>() 带 RUC/RDC 标注，属性上不能放这些标注 -->
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSql.Core\FastSql.Core.csproj" />
    <ProjectReference Include="..\..\src\FastSql.Providers.Sqlite\FastSql.Providers.Sqlite.csproj" />
  </ItemGroup>

  <!-- G1 生成器：编译期按 [Table] 实体产出契约与校验。只挂进编译器，不作为运行时引用 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSql.Generators\FastSql.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <!-- 驱动清单：运行期按 DbKind 解析 DbProviderFactory -->
  <ItemGroup>
    <None Include="..\..\FastSqlDrivers.json" Link="FastSqlDrivers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
