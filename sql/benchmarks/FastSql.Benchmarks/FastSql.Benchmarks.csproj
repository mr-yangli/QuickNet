<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FastSql.Benchmarks</RootNamespace>
    <Description>§12.8 的基准套件与门禁自检。两种跑法：不带参数 = BenchmarkDotNet 出数字；--gate = 拿门禁阈值判红绿并以退出码反馈。不是发布物。</Description>

    <!-- §12.8 第七行（首次查询元数据构建 0 次 PropertyInfo）的唯一可靠探针是生成物本体：
         托管代码里没有 API 能数出"这次解析枚举了几个 PropertyInfo"，但生成出来的 .g.cs 里
         有没有反射字样是看得见的。所以这里把生成物落盘，让门禁能直接读它。 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- §12.8 第二行的对照组。见 Directory.Packages.props 里那句"不是引入第二个 ORM"。 -->
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSql.Core\FastSql.Core.csproj" />
    <ProjectReference Include="..\..\src\FastSql.Providers.SqlServer\FastSql.Providers.SqlServer.csproj" />
  </ItemGroup>

  <!-- G1 在这里是真的：基准实体带 [Table]，编译期就生成 schema，
       于是 MetadataLookup / MaterializeWide 量到的是生成路径而不是反射兜底。 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FastSql.Generators\FastSql.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
