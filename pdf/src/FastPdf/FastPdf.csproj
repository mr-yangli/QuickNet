<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM/LangVersion/Nullable/ImplicitUsings 见 pdf/Directory.Build.props -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>FastPdf</PackageId>
    <Version>1.0.0</Version>
    <Authors>FastExcel</Authors>
    <Description>Zero-dependency PDF report/table export for .NET 10 with runtime-embedded system TrueType fonts (CJK-safe). Standalone: carries its own column model, no reference to FastExcel.</Description>
    <PackageTags>pdf;export;report;font-embedding;dotnet10</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
